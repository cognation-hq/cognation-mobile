# Cognation Supabase (same project as the website).
# Copy to `.env` or `.env.local` and fill in real values. Never commit real keys.
#
# Project URL (example shape — replace with your Cognation project URL):
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
#
# Publishable / anon key from Supabase Dashboard → Project Settings → API Keys.
# Either name works; ANON_KEY is preferred in this app, PUBLISHABLE_KEY matches Expo docs.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
